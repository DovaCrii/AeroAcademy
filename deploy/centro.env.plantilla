# ─────────────────────────────────────────────────────────────────────────────────────────────
# Configuración de AeroAcademy para producción.
#
# CÓMO USARLO (solo pegas lo que falta, marcado con «PEGA»):
#   1. Copia este archivo como  deploy/centro.env   (ese nombre está en .gitignore: nunca se sube a GitHub).
#   2. Completa las líneas «PEGA».
#   3. Súbelo a la VM junto con el proyecto y corre  sudo ./deploy/install.sh
#      El instalador lo copia a /etc/centro/env (permisos 640) la primera vez.
#
# Las líneas que ya tienen valor son los valores recomendados: no hace falta tocarlas.
# ─────────────────────────────────────────────────────────────────────────────────────────────

DJANGO_SETTINGS_MODULE=config.settings.prod

# Se genera sola al instalar si la dejas vacía. No la compartas.
SECRET_KEY=

# PEGA: el nombre MagicDNS de la VM en tu tailnet, p. ej.  levdigital01.tu-tailnet.ts.net
# (míralo con `tailscale status` o en la consola de Tailscale → Machines). Varios, separados por coma.
# En la VM compartida con AeroControl, AeroAcademy tiene su PROPIO nodo Tailscale:
#   aeroacademy.tailccd107.ts.net   (el instalador comprueba el nombre real y lo corrige solo)
ALLOWED_HOSTS=aeroacademy.tailccd107.ts.net

# Puerto HTTPS por el que se llega: 443 con el nodo propio (el instalador lo deja así).
PUBLIC_HTTPS_PORT=443

# PEGA: tu correo de Tailscale (el que usas al entrar). Queda como administrador la primera vez.
BOOTSTRAP_ADMINS=

# Rutas de datos (no cambiar salvo que muevas los discos).
DATABASE_PATH=/var/lib/centro/db.sqlite3
MEDIA_ROOT=/var/lib/centro/media
STATIC_ROOT=/opt/aeroacademy/staticfiles
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Aviso de credenciales por vencer (días).
CREDENTIAL_WARNING_DAYS=60

# ── Teo, el asistente (NVIDIA NIM) ──────────────────────────────────────────────────────────
# PEGA: tu clave de NVIDIA (empieza con «nvapi»; se crea en https://build.nvidia.com). Si la dejas vacía, Teo queda «durmiendo»
# y el resto del sitio funciona igual. Esta clave NUNCA va al repositorio ni al chat.
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Modelo: prueba con  python manage.py teo_probar  y cambia si el español no sale bien.
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Respaldos si NIM retira el modelo (se prueban en orden):
NIM_MODEL_FALLBACKS=qwen/qwen3.5-397b-a17b,google/gemma-4-31b-it,meta/llama-3.1-70b-instruct
BOT_ENABLED=true
BOT_DAILY_LIMIT=40
BOT_TIMEOUT_S=20
# Aviso semanal de Teo a quien lleva 7 días sin avanzar (se calcula en la VM, no usa la API).
TEO_NUDGES=true
