[Unit]
Description=AeroAcademy · puerta pública (Tailscale Funnel, endurecida)
After=network-online.target centro.service
Wants=network-online.target

[Service]
User=centro
Group=centro
WorkingDirectory=/opt/aeroacademy
EnvironmentFile=/etc/centro/env
# La puerta la decide ESTE proceso: AEROACADEMY_DOOR=public va por `env`, después del archivo de entorno, y ninguna
# petición puede cambiarlo. Sin identidad de Tailscale, sin el admin de Django y con segundo factor para responsables
# y admins (D36). Mismo código y misma base que centro.service; solo escucha en el puerto local 8011, detrás de
# `tailscale funnel`. --no-control-socket: el socket de control por defecto de gunicorn es una ruta fija y chocaría
# con el de centro.service.
ExecStart=/usr/bin/env AEROACADEMY_DOOR=public /opt/aeroacademy/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8011 --workers 2 --timeout 60 --no-control-socket
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/centro /opt/aeroacademy/staticfiles /opt/aeroacademy/.gunicorn

[Install]
WantedBy=multi-user.target
