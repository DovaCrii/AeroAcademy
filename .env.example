# Copiar a .env (desarrollo) o /etc/centro/env (producción). Nunca subir secretos reales.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=
ALLOWED_HOSTS=
DATABASE_PATH=
MEDIA_ROOT=
STATIC_ROOT=
TRUSTED_PROXY_IPS=127.0.0.1,::1
BOOTSTRAP_ADMINS=
# Solo desarrollo (se ignora con DEBUG=False): DEV_REMOTE_USER=correo@dominio
DEV_REMOTE_USER=
