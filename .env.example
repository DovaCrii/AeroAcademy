# Copiar a .env (desarrollo) o /etc/centro/env (producción). Nunca subir secretos reales.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=
ALLOWED_HOSTS=
DATABASE_PATH=
MEDIA_ROOT=
STATIC_ROOT=
TRUSTED_PROXY_IPS=127.0.0.1,::1
BOOTSTRAP_ADMINS=
# Solo desarrollo (se ignora con DEBUG=False): DEV_REMOTE_USER=correo@dominio
DEV_REMOTE_USER=

# Teo (asistente). La clave se crea en https://build.nvidia.com y NUNCA se escribe en el repositorio ni en el chat.
NIM_API_KEY=
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_MODEL=mistralai/mistral-large-2-instruct
BOT_ENABLED=true
BOT_DAILY_LIMIT=40
BOT_TIMEOUT_S=20
